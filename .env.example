# --- Server ---
# PORT: Railway otomatik atar; lokalde 3000 default
PORT=3000
NODE_ENV=production
SESSION_SECRET=change-me-to-a-long-random-string

# --- Admin login ---
# İlk başlatmada bu kullanıcı otomatik oluşur
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Telegram bot ---
# @BotFather'dan bot oluşturup token al
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# --- Saat dilimi (zamanlayıcı için) ---
TZ=Europe/Istanbul

# --- Kalıcı veri (Railway Volume) ---
# Railway dashboard'dan Volume oluştur, mount path: /data
# Aşağıdakileri /data altına yönlendir ki SQLite ve yüklenen görseller deploy'larda silinmesin:
DATA_DIR=/data
UPLOAD_DIR=/data/uploads
