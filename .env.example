# --- Server ---
# PORT: Railway otomatik atar; lokalde 3000 default
PORT=3000
NODE_ENV=production
SESSION_SECRET=change-me-to-a-long-random-string

# --- Admin login ---
# İlk başlatmada bu kullanıcı otomatik oluşur
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Telegram bot ---
# @BotFather'dan bot oluşturup token al
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# --- Bildirimler (opsiyonel) ---
# Gönderim kalıcı başarısız olunca buraya mesaj atılır.
# Kendi Telegram kullanıcı ID'n ya da bir bildirim kanalının chat_id'si.
# (Bota /id yazarak ya da kanaldan mesaj ileterek öğrenebilirsin.)
ADMIN_CHAT_ID=

# --- Bot üzerinden premium-emojili post (ücretsiz yol) ---
# Kanala premium (custom) emoji göndermenin Fragment'sız tek yolu: postu
# Telegram'da Premium hesapla yazıp bota gönderip, botun copyMessage ile
# kanala kopyalaması. Kimlerin bot üzerinden post oluşturabileceği:
# Virgülle ayrılmış Telegram user ID listesi. Boşsa ADMIN_CHAT_ID kullanılır.
# (Kendi ID'ni öğrenmek için bota /id yaz.)
BOT_POST_ADMINS=

# (Opsiyonel) Kalıcı kaynak deposu: bot ADMIN olduğun özel bir kanal/grup chat_id'si.
# Ayarlanırsa gelen post önce buraya kopyalanır; böylece kullanıcı orijinal
# mesajı silse bile planlanan gönderim çalışır. Boşsa botla olan özel sohbetteki
# mesaj kaynak alınır (o mesajı gönderilene kadar silme).
POST_SOURCE_CHAT_ID=

# --- Saat dilimi (zamanlayıcı için) ---
TZ=Europe/Istanbul

# --- View takibi (t.me/s public scraping) ---
# Gönderilen postların görüntülenme sayısı public kanallardan otomatik çekilir.
# VIEW_TRACKING_DAYS: postu kaç gün takip etsin (varsayılan 20)
VIEW_TRACKING_DAYS=20
# Kapatmak için 1 yap (private kanal ağırlıklıysan / istemiyorsan)
# DISABLE_VIEW_SCRAPING=1

# --- Kalıcı veri (Railway Volume) ---
# Railway dashboard'dan Volume oluştur, mount path: /data
# Aşağıdakileri /data altına yönlendir ki SQLite ve yüklenen görseller deploy'larda silinmesin:
DATA_DIR=/data
UPLOAD_DIR=/data/uploads
